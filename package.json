{
  "name": "@pragmatic-tech-ai/pragmatic-server",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pragmatic-serverd": "dist/bin/pragmatic-serverd.js",
    "pragmatic-workerd": "dist/bin/pragmatic-workerd.js",
    "pragmatic-gatewayd": "dist/bin/pragmatic-gatewayd.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
