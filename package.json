    "@pragmatic-tech-ai/todl-platform-azure": "file:../todl-platform-azure",
    "@pragmatic-tech-ai/todl-platform-cloud": "file:../todl-platform-cloud",
    "@pragmatic-tech-ai/todl-platform-gcp": "file:../todl-platform-gcp",
    "@pragmatic-tech-ai/todl-platform-node": "file:../todl-platform-node",
    "@pragmatic-tech-ai/todl-runtime": "file:../todl-runtime",
