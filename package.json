  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.10",
    "pg-mem": "^3.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "yaml": "^2.9.1"
  }
