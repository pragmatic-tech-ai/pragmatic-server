  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
