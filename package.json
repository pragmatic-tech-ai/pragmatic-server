{
  "name": "@pragmatic-tech-ai/pragmatic-server",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pragmatic-serverd": "dist/bin/pragmatic-serverd.js",
    "pragmatic-workerd": "dist/bin/pragmatic-workerd.js",
    "pragmatic-gatewayd": "dist/bin/pragmatic-gatewayd.js",
    "pragmatic-agentd": "dist/bin/pragmatic-agentd.js",
    "pragmatic-idp": "dist/bin/pragmatic-idpd.js",
    "pragmatic-tenant-admind": "dist-tenant-admin/admin/control-plane/bin/pragmatic-tenant-admind.js",
    "pragmatic-ui-unpack": "dist-tenant-admin/admin/control-plane/bin/pragmatic-ui-unpack.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:tenant-admin": "tsc -p tsconfig.tenant-admin.json",
    "build:ui-unpack": "tsc -p tsconfig.ui-unpack.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json && tsc -p admin/portal/tsconfig.json --noEmit && tsc -p admin/tenant-portal/tsconfig.json --noEmit && tsc -p idp-login/tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@pragmatic-tech-ai/pragmatic-component": "file:../pragmatic-shared/packages/pragmatic-component",
    "@pragmatic-tech-ai/pragmatic-connectors-host": "file:../todl-connectors-host",
    "@pragmatic-tech-ai/pragmatic-graph": "file:../pragmatic-graph",
    "@pragmatic-tech-ai/pragmatic-identity": "file:../pragmatic-shared/packages/pragmatic-identity",
    "@pragmatic-tech-ai/pragmatic-identity-engine-binding": "file:../todl-identity-engine",
    "@pragmatic-tech-ai/pragmatic-identity-realm": "file:../pragmatic-shared/packages/pragmatic-identity-realm",
    "@pragmatic-tech-ai/pragmatic-identity-source-entra": "file:../pragmatic-shared/packages/pragmatic-identity-source-entra",
    "@pragmatic-tech-ai/pragmatic-identity-source-google": "file:../pragmatic-shared/packages/pragmatic-identity-source-google",
    "@pragmatic-tech-ai/pragmatic-identity-source-local": "file:../pragmatic-shared/packages/pragmatic-identity-source-local",
    "@pragmatic-tech-ai/pragmatic-identity-source-oidc": "file:../pragmatic-shared/packages/pragmatic-identity-source-oidc",
    "@pragmatic-tech-ai/pragmatic-identity-store": "file:../pragmatic-shared/packages/pragmatic-identity-store",
    "@pragmatic-tech-ai/pragmatic-protocol": "file:../pragmatic-protocol",
    "@pragmatic-tech-ai/pragmatic-realm-adapters": "file:../pragmatic-shared/packages/pragmatic-realm-adapters",
    "@pragmatic-tech-ai/pragmatic-realm-aws": "file:../pragmatic-shared/packages/pragmatic-realm-aws",
    "@pragmatic-tech-ai/pragmatic-realm-azure": "file:../pragmatic-shared/packages/pragmatic-realm-azure",
    "@pragmatic-tech-ai/pragmatic-realm-custom": "file:../pragmatic-shared/packages/pragmatic-realm-custom",
    "@pragmatic-tech-ai/pragmatic-realm-gcp": "file:../pragmatic-shared/packages/pragmatic-realm-gcp",
    "@pragmatic-tech-ai/todl": "file:../TODL",
    "@pragmatic-tech-ai/todl-runtime": "file:../todl-runtime",
    "jose": "^6.0.0",
    "pg": "^8.13.0",
    "redis": "^4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.10",
    "pg-mem": "^3.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "yaml": "^2.9.1"
  }
}
